# services/minecraft-deploy-daemon.env.example
#
# Copy to /etc/minecraft-deploy/daemon.env and fill in the token.
# Permissions: 0600, owned by minecraft-deploy.

# Required. The value the daemon expects in `Authorization: Bearer <token>`.
# Must match the `bearer_token_env` key in [daemon] of deploy_pack.toml,
# which defaults to MINECRAFT_DAEMON_TOKEN.
MINECRAFT_DAEMON_TOKEN=replace-with-a-strong-token