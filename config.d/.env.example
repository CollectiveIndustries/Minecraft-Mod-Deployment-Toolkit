# Copy to config.d/.env and fill in values.
#
# deploy_mode selects which compose file and instance set the toolchain
# uses. Precedence: --deploy-mode CLI > deploy_mode here > "prod".
# Values: "prod" or "dev".
#
# On PROD: deploy_mode=prod (or omit — defaults to prod).
# On DEV:  deploy_mode=dev.

deploy_mode=prod

# Discord webhook (legacy path — superseded by [discord.notify_dispatch]
# when the bot daemon is in use).
webhook_url=https://discord.com/api/webhooks/xxx/yyy